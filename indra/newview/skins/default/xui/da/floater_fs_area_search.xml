<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="area_search" title="Area Search for Objects">
  <tab_container name="area_searchtab">
    <panel name="area_search_list_panel" label="List">
      <panel.string name="ListedPendingTotalBlank">
        Listed | Pending | Total
      </panel.string>
      <panel.string name="ListedPendingTotalFilled">
        [LISTED] Listed | [PENDING] Pending | [TOTAL] Total
      </panel.string>
      <fs_scroll_list name="result_list">
        <fs_scroll_list.columns name="distance" label="Dist" tool_tip="Distance from your avatar to the object."/>
        <fs_scroll_list.columns name="name" label="Navn"/>
        <fs_scroll_list.columns name="description" label="Beskrivelse"/>
        <fs_scroll_list.columns name="price" label="Pris" tool_tip="If the object is for sale, what you'd pay to purchase it."/>
        <fs_scroll_list.columns name="land_impact" label="LI" tool_tip="The number that is counted against your parcel's maximum."/>
        <fs_scroll_list.columns name="prim_count" label="Prims" tool_tip="Count of prims that make up each object."/>
        <fs_scroll_list.columns name="owner" label="Ejer"/>
        <fs_scroll_list.columns name="group" label="Group" tool_tip="What group the object is set to."/>
        <fs_scroll_list.columns name="creator" label="Ophavsmand"/>
        <fs_scroll_list.columns name="last_owner" label="Last Owner" tool_tip="Who owned it last."/>
      </fs_scroll_list>
      <button name="Refresh" label="Opdater"/>
      <text name="counter">
        Listed | Pending | Total
      </text>
      <check_box name="beacons" label="Show beacons"/>
    </panel>
    <panel name="area_search_find_panel" label="Find">
      <text name="name_label">
        Navn:
      </text>
      <text name="desc_label">
        Description:
      </text>
      <text name="owner_label">
        Owner:
      </text>
      <text name="group_label">
        Group:
      </text>
      <text name="creator_label">
        Creator:
      </text>
      <text name="last_owner_label">
        Last owner:
      </text>
      <check_box name="regular_expression" label="Use regular expression"/>
      <button name="search" label="Søg"/>
      <button name="clear" label="Ryd"/>
      <button name="copy_link" label="Copy as link" tool_tip="Copies a secondlife:///app/openfloater/area_search?... link reproducing the current search and filter settings."/>
    </panel>
    <panel name="area_search_filter_panel" label="Filter">
      <text name="only_list">
        Only list objects that are:
      </text>
      <check_box name="filter_locked" label="Locked"/>
      <check_box name="filter_physical" label="Physical"/>
      <check_box name="filter_phantom" label="Phantom"/>
      <check_box name="filter_temporary" label="Temporary"/>
      <check_box name="filter_attachment" label="Attachment"/>
      <check_box name="filter_moap" label="Shared Media"/>
      <check_box name="filter_perm_copy" label="Kopier"/>
      <check_box name="filter_perm_modify" label="Modify"/>
      <check_box name="filter_perm_transfer" label="Transfer"/>
      <check_box name="filter_reflection_probe" label="Reflection Probes" tool_tip="Includes manual probes only, not auto-probes. Only includes mirror probes if mirrors are enabled in graphics preferences. If reflection coverage is set to 'none', or the probe is not baked, objects may not be identified."/>
      <check_box name="filter_for_sale" label="For Sale between"/>
      <text name="and">
        and
      </text>
      <text name="mouse_text">
        Mouse click action
      </text>
      <combo_box name="click_action" tool_tip="Action that is performed when clicking on an object.">
        <combo_box.item name="click_blank" label=" "/>
        <combo_box.item name="click_any" label="Any"/>
        <combo_box.item name="click_touch" label="Touch"/>
        <combo_box.item name="click_sit" label="Sit"/>
        <combo_box.item name="click_buy" label="Køb"/>
        <combo_box.item name="click_pay" label="Betal"/>
        <combo_box.item name="click_open" label="Åbn"/>
        <combo_box.item name="click_play" label="Afspil"/>
        <combo_box.item name="click_open_media" label="Open Media"/>
        <combo_box.item name="click_zoom" label="Zoom"/>
      </combo_box>
      <check_box name="filter_distance" label="Distance between"/>
      <text name="and2">
        and
      </text>
      <check_box name="filter_agent_parcel_only" label="Current Parcel only"/>
      <text name="only_list">
        Exclude objects that are:
      </text>
      <check_box name="exclude_attachment" label="Attachment"/>
      <check_box name="exclude_physical" label="Physical"/>
      <check_box name="exclude_temporary" label="Temporary"/>
      <check_box name="exclude_reflection_probes" label="Reflection Probes"/>
      <check_box name="exclude_childprim" label="Child Prim"/>
      <check_box name="exclude_neighbor_region" label="Neighboring Regions"/>
      <button name="apply" label="Anvend"/>
      <button name="save_as_default" label="Save as Default"/>
    </panel>
    <panel name="area_search_options_panel" label="Valgmuligheder">
      <text name="display_column">
        Display column:
      </text>
      <check_box name="show_distance" label="Distance"/>
      <check_box name="show_name" label="Navn"/>
      <check_box name="show_description" label="Beskrivelse"/>
      <check_box name="show_price" label="Pris"/>
      <check_box name="show_land_impact" label="Land Impact"/>
      <check_box name="show_prim_count" label="Prim Count"/>
      <check_box name="show_owner" label="Ejer"/>
      <check_box name="show_group" label="Group"/>
      <check_box name="show_creator" label="Ophavsmand"/>
      <check_box name="show_last_owner" label="Last owner"/>
    </panel>
    <panel name="area_search_advanced_panel" label="Advanced">
      <check_box name="double_click_touch" label="Double click touch object"/>
      <check_box name="double_click_buy" label="Double click buy object"/>
      <check_box name="double_click_sit" label="Double click sit on object"/>
    </panel>
  </tab_container>
</floater>
