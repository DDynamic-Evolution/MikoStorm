<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="omnifilter" title="Omnifilter Rules Editor">
  <floater.string name="OmnifilterNewNeedle">
    NEW RULE
  </floater.string>
  <panel name="needle_rule_set_controls">
    <layout_stack name="rule_set_buttons_stack">
      <layout_panel name="rule_set_group_1">
        <combo_box name="cmb_rule_sets" tool_tip="Choose the Omnifilter Rule Set to use."/>
      </layout_panel>
      <layout_panel name="rule_set_group_2">
        <button name="btn_rule_set_new" label="New Rule Set" tool_tip="Create a new blank Omnifilter Rule Set."/>
      </layout_panel>
      <layout_panel name="rule_set_group_3">
        <button name="btn_rule_set_clone" label="Clone Rule Set" tool_tip="Create a clone of the current Omnifilter Rule Set."/>
      </layout_panel>
      <layout_panel name="rule_set_group_4">
        <button name="btn_rule_set_remove" label="Remove Rule Set" tool_tip="Remove the current Omnifilter Rule Set."/>
      </layout_panel>
    </layout_stack>
  </panel>
  <layout_stack name="needle_list_stack">
    <layout_panel name="needle_list_layout">
      <check_box name="enable_omnifilter" label="Enable Omnifilter"/>
      <fs_scroll_list name="needle_list">
        <fs_scroll_list.columns name="enabled" label="Til"/>
        <fs_scroll_list.columns name="needle_name" label="Rule"/>
        <row >
          <column name="needle_name">
            Example Rule 1
          </column>
        </row>
        <row >
          <column name="needle_name">
            Example Rule 2
          </column>
        </row>
      </fs_scroll_list>
      <button name="add_needle" label="Tilføj"/>
      <button name="remove_needle" label="Fjern"/>
      <button name="up_needle" label="Up" tool_tip="Selected rule is moved up one position."/>
      <button name="down_needle" label="Down" tool_tip="Selected rule is moved down one position."/>
    </layout_panel>
    <layout_panel name="filter_log_layout">
      <fs_scroll_list name="filter_log">
        <fs_scroll_list.columns name="timestamp" label="Time (SLT)"/>
        <fs_scroll_list.columns name="log_entry" label="Rule"/>
        <row >
          <column name="timestamp" tool_tip="2015-11-24 00:01:02">
            00:01:02
          </column>
          <column name="log_entry">
            Example Rule 1
          </column>
        </row>
        <row >
          <column name="timestamp" tool_tip="2015-11-24 01:02:03">
            01:02:03
          </column>
          <column name="log_entry">
            Example Rule 2
          </column>
        </row>
      </fs_scroll_list>
    </layout_panel>
    <layout_panel name="inport_export_layout">
      <button name="btn_rule_set_export" label="Export" tool_tip="Export rule set to a Notecard."/>
      <button name="btn_rule_set_import" label="Import" tool_tip="Import a rule set from a Notecard."/>
    </layout_panel>
  </layout_stack>
  <panel name="panel_details">
    <line_editor name="sender_name" tool_tip="The avatar or object name the message comes from"/>
    <check_box name="sender_case" label="Aa" tool_tip="Case Sensitivity"/>
    <combo_box name="sender_match_type" tool_tip="Matching Mode">
      <combo_item name="sender_exact">
        <column name="label" label="|Abc|"/>
        <column name="longtext" label="Match full text"/>
      </combo_item>
      <combo_item name="sender_substring">
        <column name="label" label="*Abc*"/>
        <column name="longtext" label="Match substring"/>
      </combo_item>
      <combo_item name="sender_regex">
        <column name="label" label="/ *. /"/>
        <column name="longtext" label="Match regular expression"/>
      </combo_item>
    </combo_box>
    <text_editor name="content" tool_tip="The actual text of the message"/>
    <check_box name="content_case" label="Aa" tool_tip="Case Sensitivity"/>
    <combo_box name="content_match_type" tool_tip="Matching Mode">
      <combo_item name="content_exact">
        <column name="label" label="|Abc|"/>
        <column name="longtext" label="Match full text"/>
      </combo_item>
      <combo_item name="content_substring">
        <column name="label" label="*Abc*"/>
        <column name="longtext" label="Match substring"/>
      </combo_item>
      <combo_item name="content_regex">
        <column name="label" label="/ *. /"/>
        <column name="longtext" label="Match regular expression"/>
      </combo_item>
    </combo_box>
    <line_editor name="region_name" tool_tip="The region name of the source. Only available for inventory offers."/>
    <line_editor name="owner_uuid" label="00000000-0000-0000-0000-000000000000" tool_tip="For group invites: The group's UUID. For object chat, owner say, debug chat or direct chat: The UUID of the object. For object IMs: The UUID of the object owner. For everything else, the UUID of the sender avatar."/>
    <layout_stack name="buttons_stack">
      <layout_panel name="buttons_group_1">
        <button name="type_nearby" label="Local Chat" tool_tip="Regular public avatar chat nearby."/>
        <button name="type_im" label="IM" tool_tip="Instant messages from residents."/>
        <button name="type_group_im" label="Group Chat" tool_tip="Group chat from residents."/>
      </layout_panel>
      <layout_panel name="buttons_group_2">
        <button name="type_group_notice" label="Notice" tool_tip="Group notices."/>
        <button name="type_invite" label="Invitér" tool_tip="Group invitations."/>
        <button name="type_object_chat" label="Object Chat" tool_tip="Nearby chat from objects."/>
      </layout_panel>
      <layout_panel name="buttons_group_3">
        <button name="type_object_im" label="Object IM" tool_tip="Instant messages from objects."/>
        <button name="type_script_error" label="Fejl" tool_tip="Debug chat coming from scripts."/>
        <button name="type_dialog" label="Dialog" tool_tip="Matches fields in script dialogs."/>
      </layout_panel>
      <layout_panel name="buttons_group_4">
        <button name="type_inventory_offer" label="Offer" tool_tip="Matches fields in inventory offers."/>
        <button name="type_friendship" label="Friendship" tool_tip="Friend requests from residents."/>
        <button name="type_lure" label="TP Lure" tool_tip="Teleport offers from residents."/>
      </layout_panel>
      <layout_panel name="buttons_group_5">
        <button name="type_tp_request" label="TP Request" tool_tip="Requests from residents to send them a teleport offer."/>
        <button name="type_load_url" label="Load URL" tool_tip="Scripted requests to visit a website."/>
      </layout_panel>
    </layout_stack>
    <line_editor name="chat_replace" tool_tip="Replacement text that can be used to alter how the message is displayed"/>
    <line_editor name="button_reply" tool_tip="The label of a button to "click" on the scripted dialog, including "Ignore""/>
    <text_editor name="text_box_reply" tool_tip="A reply text, as if it had been typed manually into the scripted dialog text box"/>
  </panel>
</floater>
