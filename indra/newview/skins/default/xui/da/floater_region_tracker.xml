<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="region_tracker" title="Region Tracker">
  <button name="refresh" tool_tip="Opdater"/>
  <button name="remove" tool_tip="Remove region(s)"/>
  <button name="open_map" tool_tip="Open map"/>
  <scroll_list name="region_list" tool_tip="Double click an entry to open it on the world map.">
    <scroll_list.columns name="region_label" label="Label"/>
    <scroll_list.columns name="region_name" label="Region"/>
    <scroll_list.columns name="region_agent_count" label="#"/>
  </scroll_list>
</floater>
