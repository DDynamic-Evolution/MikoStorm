<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="Marketplace Panel" label="Marketplace">
  <panel name="tool_panel">
    <menu_button name="sort_btn" tool_tip="View/sort options"/>
    <button name="add_btn" tool_tip="Create a new listing folder"/>
    <button name="audit_btn" label="Check for Errors" tool_tip="Check your marketplace listings"/>
  </panel>
