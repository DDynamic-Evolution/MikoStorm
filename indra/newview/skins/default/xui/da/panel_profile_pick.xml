<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_pick_info">
  <panel.string name="location_notice">
    (will update after save)
  </panel.string>
  <layout_stack name="main_pick_stack">
    <layout_panel name="main_pick_lp">
      <text name="title_label">
        Title:
      </text>
      <text name="description_label">
        Description:
      </text>
      <button name="btn_preview" tool_tip="Toggle preview of your pick description"/>
      <text name="location_label">
        Location:
      </text>
      <line_editor name="pick_location">
        Indlæser...
      </line_editor>
    </layout_panel>
    <layout_panel name="util_buttons_lp">
      <layout_stack name="util_buttons_stack">
        <layout_panel name="map_btn_lp">
          <button name="show_on_map_btn" label="Show on Map"/>
        </layout_panel>
        <layout_panel name="tp_btn_lp">
          <button name="teleport_btn" label="Teleporter"/>
        </layout_panel>
        <layout_panel name="set_to_curr_location_btn_lp">
          <button name="set_to_curr_location_btn" label="Set Location" tool_tip="Set to Current Location"/>
        </layout_panel>
      </layout_stack>
    </layout_panel>
    <layout_panel name="save_changes_lp">
      <layout_stack name="save_changes_stack">
        <layout_panel name="create_btn_lp">
          <button name="create_changes_btn" label="Create Pick"/>
        </layout_panel>
        <layout_panel name="save_btn_lp">
          <button name="save_changes_btn" label="Save Pick"/>
        </layout_panel>
        <layout_panel name="cancel_btn_lp">
          <button name="cancel_changes_btn" label="Annuller"/>
        </layout_panel>
      </layout_stack>
    </layout_panel>
  </layout_stack>
</panel>
