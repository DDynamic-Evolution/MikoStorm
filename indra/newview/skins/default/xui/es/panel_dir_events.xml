    <combo_item name="LiveMusic" label="Live Music"/>
    <combo_item name="LiveDJ" label="Live DJ"/>
    <combo_item name="Commercial" label="Commercial"/>
    <combo_item name="Nightlife/Entertainment" label="Nightlife/Entertainment"/>
    <combo_item name="Games/Contests" label="Games/Contests"/>
    <combo_item name="Pageants" label="Pageants"/>
    <combo_item name="Education" label="Education"/>
    <combo_item name="ArtsandCulture" label="Arts and Culture"/>
    <combo_item name="Charity/SupportGroups" label="Charity/Support Groups"/>
    <combo_item name="Miscellaneous" label="Miscellaneous"/>
  </combo_box>
  <check_box name="incpg" label=""/>
  <icon name="rating_icon_general" tool_tip="General"/>
  <check_box name="incmature" label=""/>
  <icon name="rating_icon_moderate" tool_tip="Moderate"/>
  <check_box name="incadult" label=""/>
