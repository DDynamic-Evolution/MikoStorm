    <combo_box.item name="golden_ratio_top_right" label="Golden Ratio (Top Right)"/>
    <combo_box.item name="golden_ratio_bottom_left" label="Golden Ratio (Bottom Left)"/>
    <combo_box.item name="golden_ratio_bottom_right" label="Golden Ratio (Bottom Right)"/>
    <combo_box.item name="diagonal" label="Diagonal"/>
  </combo_box>
</floater>
