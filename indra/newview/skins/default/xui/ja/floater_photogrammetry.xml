  <spinner name="height_min" label="最小高さ（m）"/>
  <spinner name="height_max" label="最大高さ（m）"/>
  <text name="image_settings_label">
    画像設定
  </text>
  <combo_box name="resolution_combo" label="解像度">
    <combo_item name="current">
      現在のウィンドウ
    </combo_item>
    <combo_item name="1920x1080">
      1920 x 1080
    </combo_item>
    <combo_item name="2560x1440">
      2560 x 1440
    </combo_item>
    <combo_item name="3840x2160">
      3840 x 2160 (4K)
    </combo_item>
    <combo_item name="4096x2160">
      4096 x 2160
    </combo_item>
    <combo_item name="7680x4320">
      7680 x 4320 (8K)
    </combo_item>
    <combo_item name="1080x2340">
      1080 x 2340 (9:19.5)
    </combo_item>
    <combo_item name="1080x2400">
      1080 x 2400 (9:20)
    </combo_item>
    <combo_item name="1080x2520">
      1080 x 2520 (9:21)
    </combo_item>
    <combo_item name="2340x1080">
      2340 x 1080 (19.5:9)
    </combo_item>
    <combo_item name="2400x1080">
      2400 x 1080 (20:9)
    </combo_item>
    <combo_item name="2520x1080">
      2520 x 1080 (21:9)
    </combo_item>
    <combo_item name="custom">
      カスタム
    </combo_item>
  </combo_box>
  <spinner name="custom_width" label="カスタム幅"/>
  <spinner name="custom_height" label="カスタム高さ"/>
  <button name="browse_btn" label="参照"/>
  <text name="estimated_size_label">
    推定サイズ:
  </text>
  <button name="start_btn" label="キャプチャ開始"/>
  <button name="stop_btn" label="停止"/>
