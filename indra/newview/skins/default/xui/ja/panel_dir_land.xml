<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_dir_land" label="Land Sales">
  <string name="searching_text">
    Searching...
  </string>
  <string name="not_found_text">
    None found.
  </string>
  <string name="found_text">
    [COUNT] found.
  </string>
  <text name="find">
    Enter search terms:
  </text>
  <combo_box name="type">
    <combo_item name="AllTypes" label="All Types"/>
    <combo_item name="Auction" label="Auction"/>
    <combo_item name="MainlandSales" label="For Sale - Mainland"/>
    <combo_item name="EstateSales" label="For Sale - Estate"/>
  </combo_box>
  <check_box name="incpg" label=""/>
  <icon name="rating_icon_general" tool_tip="General"/>
  <check_box name="incmature" label=""/>
  <icon name="rating_icon_moderate" tool_tip="Moderate"/>
  <check_box name="incadult" label=""/>
  <icon name="rating_icon_adult" tool_tip="Adult"/>
  <check_box name="pricecheck" label="Price ≤ "/>
  <text name="pricecheck_symbol">
    L$
  </text>
  <check_box name="areacheck" label="Area ≥ "/>
  <text name="areacheck_symbol">
    m²
  </text>
  <button name="Search" label="検索"/>
  <scroll_list name="results">
    <column name="icon" label=""/>
    <column name="name" label="名前"/>
    <column name="landtype" label="タイプ"/>
    <column name="price" label="L$ Price"/>
    <column name="area" label="Area"/>
    <column name="per_meter" label="L$/m²"/>
  </scroll_list>
  <button name="prev_btn" tool_tip="Previous page"/>
  <button name="next_btn" tool_tip="Next page"/>
</panel>
