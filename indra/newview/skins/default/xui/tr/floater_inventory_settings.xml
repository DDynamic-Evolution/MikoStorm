<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="inventory_settings" title="Inventory Settings">
  <text name="multi_folder_txt">
    Double-click on folder in multi-folder view:
  </text>
  <radio_group name="multi_double_click_setting">
    <radio_item name="0" label="Expands & collapses folder"/>
    <radio_item name="1" label="Opens a new window"/>
    <radio_item name="2" label="Switches view"/>
  </radio_group>
  <text name="single_folder_txt">
    Double-click on folder in single-folder view:
  </text>
  <radio_group name="single_double_click_setting">
    <radio_item name="false" label="Stays in current window"/>
    <radio_item name="true" label="Opens a new window"/>
  </radio_group>
  <text name="find_original_txt">
    Clicking on "Show in inventory" or "Find original"
  </text>
  <radio_group name="find_original_settings">
    <radio_item name="false" label="Shows item in main inventory window"/>
    <radio_item name="true" label="Opens a new single-folder window"/>
  </radio_group>
  <text name="favorites_txt">
    Favorites
  </text>
  <check_box name="favorite_star" label="Star on favorite items"/>
  <check_box name="favorite_hollow_star" label="Star on folders containing a favorite"/>
  <check_box name="favorites_color" label="Colored text"/>
  <text name="attachment_return_txt">
    Pressing enter or double clicking on an avatar attachment
  </text>
  <combo_box name="attach_combo">
    <combo_box.item name="1" label="Adds attachment (recommended)"/>
    <combo_box.item name="0" label="Wear (removes attachment at that point)"/>
  </combo_box>
</floater>
