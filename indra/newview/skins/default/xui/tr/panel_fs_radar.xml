<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_radar">
  <panel name="nearby_panel">
    <panel name="nearby_buttons_panel" label="bottom_panel">
      <filter_editor name="nearby_filter_input" label="Filter People"/>
      <button name="gear_btn" tool_tip="Actions on selected person"/>
      <menu_button name="options_btn" tool_tip="Radar options"/>
      <button name="add_friend_btn" tool_tip="Offer friendship to a resident"/>
    </panel>
    <layout_stack name="radar_outer_ls">
      <layout_panel name="radar_upper_layout">
        <layout_stack name="radar_ls">
          <layout_panel name="radarlayout">
            <radar_list name="radar_list">
              <radar_list.columns name="name" label="Ad" tool_tip="[TOTAL] avatars, [IN_REGION] in the same region, [IN_CHAT_RANGE] in chat range"/>
              <radar_list.columns name="voice_level" label="" tool_tip="Is talking on voice"/>
              <radar_list.columns name="in_region" label="" tool_tip="Is in the same region (green) or on the same parcel (green/yellow)"/>
              <radar_list.columns name="typing_status" label="" tool_tip="Is typing"/>
              <radar_list.columns name="sitting_status" label="" tool_tip="Is sitting"/>
              <radar_list.columns name="flags" label="" tool_tip="Payment info status"/>
              <radar_list.columns name="has_notes" label="" tool_tip="Avatar has notes"/>
              <radar_list.columns name="age" label="Age"/>
              <radar_list.columns name="seen" label="Seen"/>
              <radar_list.columns name="range" label="Range"/>
            </radar_list>
          </layout_panel>
        </layout_stack>
      </layout_panel>
      <layout_panel name="radar_lower_layout">
        <slider name="NearMeRange" label="Range (m):"/>
      </layout_panel>
    </layout_stack>
  </panel>
</panel>
