    <combo_item name="2520x1080">
      2520 x 1080 (21:9)
    </combo_item>
    <combo_item name="custom">
      自定义
    </combo_item>
  </combo_box>
  <spinner name="custom_width" label="自定义宽度"/>
  <spinner name="custom_height" label="自定义高度"/>
  <button name="browse_btn" label="浏览"/>
  <text name="estimated_size_label">
    预估大小：
  </text>
  <button name="start_btn" label="开始捕获"/>
  <button name="stop_btn" label="停止"/>
